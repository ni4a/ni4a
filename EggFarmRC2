local function applyForceFieldToCharacter(isOn)
    local char = plr.Character
    if not char then return end

    if isOn then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                originalProps[part] = { part.Material, part.Color }
                part.Material = Enum.Material.ForceField
                part.Color = Color3.new(0,0,0)
            end
        end
    else
        for part, props in pairs(originalProps) do
            if part and part.Parent then
                part.Material = props[1]
                part.Color = props[2]
            end
        end
        originalProps = {}
    end
end


spawn(function()
    while true do
        task.wait(1)
        if running and startTime then
            local elapsed = os.time() - startTime
            local hrs = math.floor(elapsed/3600)
            local mins = math.floor((elapsed % 3600)/60)
            timerLabel.Text = string.format("Farming Egg For: %02d:%02d", hrs, mins)
        end
    end
end)

btn.MouseButton1Click:Connect(function()
    running = not running
    if running then
        btn.Text = "STOP"
        startTime = os.time()

        local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            teleportCFrame = hrp.CFrame

            circlePart = Instance.new("Part", workspace)
            circlePart.Size = Vector3.new(6,1,6)
            circlePart.CFrame = teleportCFrame * CFrame.Angles(math.rad(90),0,0)
            circlePart.Anchored = true
            circlePart.CanCollide = false
            circlePart.Material = Enum.Material.ForceField
            circlePart.Color = Color3.fromHex("#FFFFFF")
        end

        applyForceFieldToCharacter(true)

        task.spawn(function()
            while running do
                task.wait(1)
                if plr.Character and teleportCFrame then
                    local hrp2 = plr.Character:FindFirstChild("HumanoidRootPart")
                    if hrp2 then hrp2.CFrame = teleportCFrame end
                end
            end
        end)

        task.spawn(function()
            while running do
                task.wait(5)
                VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
            end
        end)

        task.spawn(function()
            while running do
                task.wait(15)
                VIM:SendKeyEvent(true, Enum.KeyCode.One, false, game)
                VIM:SendKeyEvent(false, Enum.KeyCode.One, false, game)
                task.wait(0.1)
                VIM:SendKeyEvent(true, Enum.KeyCode.Backspace, false, game)
                VIM:SendKeyEvent(false, Enum.KeyCode.Backspace, false, game)
            end
        end)

        task.spawn(function()
            while running do
                task.wait(30)
                local humanoid = plr.Character and plr.Character:FindFirstChild("Humanoid")
                if humanoid then
                    humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                end
            end
        end)
    else
        btn.Text = "START"
        timerLabel.Text = "Farming Egg For: 00:00"
        startTime = nil

        if circlePart then circlePart:Destroy() circlePart = nil end
        teleportCFrame = nil
        applyForceFieldToCharacter(false)
    end
end)
